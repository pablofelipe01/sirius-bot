# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a git.

# --- Meta / WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=            # Token permanente del System User
WHATSAPP_PHONE_NUMBER_ID=549187558283676
WHATSAPP_BUSINESS_ACCOUNT_ID=     # WABA ID (referencia; el código no lo usa todavía)
WHATSAPP_APP_SECRET=              # App Dashboard → Configuración → Básica
WHATSAPP_VERIFY_TOKEN=            # Texto aleatorio que inventas tú; el mismo va en la config del webhook en Meta
WHATSAPP_API_VERSION=v23.0

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase (historial). Si se dejan vacías, se usa memoria (solo desarrollo local) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
